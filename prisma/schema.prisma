// Skema database Harmony.
//
// Catatan Prisma 7:
// - Generator `prisma-client` (Rust-free) menulis client ke src/generated/
//   supaya bisa langsung dipakai ESM + NodeNext.
// - URL database TIDAK lagi ditulis di sini; diatur di prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Konfigurasi bot untuk satu server (guild). Satu baris per guild.
model GuildConfig {
  guildId String @id @db.VarChar(20)

  // Channel & role
  logChannelId     String? @db.VarChar(20)
  welcomeChannelId String? @db.VarChar(20)
  goodbyeChannelId String? @db.VarChar(20)
  djRoleId         String? @db.VarChar(20)
  /// Role otomatis untuk member manusia dan bot (dipisah karena kebutuhan berbeda).
  autoroleId       String? @db.VarChar(20)
  autoroleBotId    String? @db.VarChar(20)

  // Teks sambutan & perpisahan, mendukung placeholder {user} {mention} {server} {count}
  welcomeMessage String? @db.VarChar(1500)
  goodbyeMessage String? @db.VarChar(1500)

  // Preferensi musik
  defaultVolume  Int @default(100)
  idleTimeoutSec Int @default(300)

  /// Modul aktif: { music, moderation, automod, logging }
  modulesEnabled Json @default("{\"music\": true, \"moderation\": true, \"automod\": false, \"logging\": false}")

  locale String @default("id") @db.VarChar(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_config")
}

/// Semua aksi moderasi (ban/kick/timeout/warn) — satu baris per aksi.
/// Nomor kasus unik per server dan dipakai di semua pesan/log (mis. #CASE-0142).
model ModerationCase {
  id          Int      @id @default(autoincrement())
  caseNumber  Int
  guildId     String   @db.VarChar(20)
  type        String   @db.VarChar(20)
  targetId    String   @db.VarChar(20)
  moderatorId String   @db.VarChar(20)
  reason      String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  active      Boolean  @default(true)

  warnings Warning[]

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId, createdAt])
  @@index([guildId, createdAt])
  @@map("moderation_case")
}

/// Peringatan aktif & historis. Satu /warn = satu case + satu baris di sini.
model Warning {
  id          Int      @id @default(autoincrement())
  guildId     String   @db.VarChar(20)
  userId      String   @db.VarChar(20)
  moderatorId String   @db.VarChar(20)
  reason      String?  @db.VarChar(1000)
  caseId      Int
  createdAt   DateTime @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, createdAt])
  @@map("warning")
}

/// Aturan automod per server (satu baris per tipe rule).
/// Baris yang belum ada memakai default dari kode — lihat src/modules/automod/types.ts.
model AutomodRule {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(20)
  type      String   @db.VarChar(20)
  enabled   Boolean  @default(true)
  /// Ambang pemicu; 0 untuk rule yang tidak memakai ambang (invite/link/badword).
  threshold Int      @default(0)
  /// Daftar aksi saat rule terpicu, mis. ["delete", "warn"].
  actions   Json
  /// { channels, roles, domains, words, invites }
  whitelist Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, type])
  @@map("automod_rule")
}

/// Routing log per kategori (PRD §7.3). Tanpa baris = pakai logChannelId global.
model LogSubscription {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(20)
  /// member | message | channel | role | voice | server
  category  String   @db.VarChar(20)
  channelId String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, category])
  @@map("guild_log_subscription")
}
