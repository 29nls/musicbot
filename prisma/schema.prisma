// Skema database Harmony.
//
// Catatan Prisma 7:
// - Generator `prisma-client` (Rust-free) menulis client ke src/generated/
//   supaya bisa langsung dipakai ESM + NodeNext.
// - URL database TIDAK lagi ditulis di sini; diatur di prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Konfigurasi bot untuk satu server (guild). Satu baris per guild.
model GuildConfig {
  guildId String @id @db.VarChar(20)

  // Channel & role
  logChannelId     String? @db.VarChar(20)
  welcomeChannelId String? @db.VarChar(20)
  goodbyeChannelId String? @db.VarChar(20)
  djRoleId         String? @db.VarChar(20)
  /// Role otomatis untuk member manusia dan bot (dipisah karena kebutuhan berbeda).
  autoroleId       String? @db.VarChar(20)
  autoroleBotId    String? @db.VarChar(20)

  // Teks sambutan & perpisahan, mendukung placeholder {user} {mention} {server} {count}
  welcomeMessage String? @db.VarChar(1500)
  goodbyeMessage String? @db.VarChar(1500)

  // Preferensi musik
  defaultVolume  Int @default(100)
  idleTimeoutSec Int @default(300)

  // Sistem tiket: channel panel, kategori channel privat, dan role staff.
  ticketPanelChannelId String? @db.VarChar(20)
  ticketCategoryId     String? @db.VarChar(20)
  ticketStaffRoleId    String? @db.VarChar(20)
  /// ID pesan panel tiket, supaya bisa diedit tanpa kirim ulang.
  ticketPanelMessageId String? @db.VarChar(20)

  /// Modul aktif: { music, moderation, automod, logging, reactions, tickets }
  modulesEnabled Json @default("{\"music\": true, \"moderation\": true, \"automod\": false, \"logging\": false, \"reactions\": false, \"tickets\": false}")

  locale String @default("id") @db.VarChar(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guild_config")
}

/// Semua aksi moderasi (ban/kick/timeout/warn) — satu baris per aksi.
/// Nomor kasus unik per server dan dipakai di semua pesan/log (mis. #CASE-0142).
model ModerationCase {
  id          Int      @id @default(autoincrement())
  caseNumber  Int
  guildId     String   @db.VarChar(20)
  type        String   @db.VarChar(20)
  targetId    String   @db.VarChar(20)
  moderatorId String   @db.VarChar(20)
  reason      String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  active      Boolean  @default(true)
  /// Hasil pengiriman DM ke target: sent | failed.
  /// null = aksi ini memang tidak mengirim DM (slowmode/lock/unlock/note), atau
  /// kasusnya dibuat sebelum kolom ini ada — dua hal itu dibedakan lewat
  /// NOTIFIABLE_ACTIONS di sisi aplikasi.
  dmStatus    String?  @db.VarChar(20)

  warnings Warning[]

  @@unique([guildId, caseNumber])
  @@index([guildId, targetId, createdAt])
  @@index([guildId, moderatorId, createdAt(sort: Desc)])
  @@index([guildId, createdAt])
  @@map("moderation_case")
}

/// Peringatan aktif & historis. Satu /warn = satu case + satu baris di sini.
model Warning {
  id          Int      @id @default(autoincrement())
  guildId     String   @db.VarChar(20)
  userId      String   @db.VarChar(20)
  moderatorId String   @db.VarChar(20)
  reason      String?  @db.VarChar(1000)
  caseId      Int
  createdAt   DateTime @default(now())

  case ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([guildId, userId, createdAt])
  @@map("warning")
}

/// Aturan automod per server (satu baris per tipe rule).
/// Baris yang belum ada memakai default dari kode — lihat src/modules/automod/types.ts.
model AutomodRule {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(20)
  type      String   @db.VarChar(20)
  enabled   Boolean  @default(true)
  /// Ambang pemicu; 0 untuk rule yang tidak memakai ambang (invite/link/badword).
  threshold Int      @default(0)
  /// Daftar aksi saat rule terpicu, mis. ["delete", "warn"].
  actions   Json
  /// { channels, roles, domains, words, invites }
  whitelist Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, type])
  @@map("automod_rule")
}

/// Routing log per kategori (PRD §7.3). Tanpa baris = pakai logChannelId global.
model LogSubscription {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(20)
  /// member | message | channel | role | voice | server
  category  String   @db.VarChar(20)
  channelId String   @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, category])
  @@map("guild_log_subscription")
}

/// Riwayat log yang pernah dikirim (PRD §7.3) — dasar perintah `/logs`.
model LogEntry {
  id       Int    @id @default(autoincrement())
  guildId  String @db.VarChar(20)
  /// member | message | channel | role | voice | server
  category String @db.VarChar(20)
  /// Nama event Discord, mis. guildBanAdd.
  eventKey String @db.VarChar(50)
  title    String @db.VarChar(200)
  /// Teks gabungan embed (deskripsi + nilai field) supaya bisa dicari kata kunci.
  summary  String @db.VarChar(1000)
  /// Siapa yang melakukan; null untuk aksi sistem atau pelanggarnya sendiri.
  executorId String? @db.VarChar(20)
  /// Subjek aksi: member, channel, atau role. Null kalau tidak relevan.
  targetId String? @db.VarChar(20)
  /// Channel tempat aksi terjadi (bukan channel tujuan log).
  channelId String? @db.VarChar(20)
  /// Channel tujuan log; null kalau embed gagal dikirim.
  logChannelId String? @db.VarChar(20)
  /// ID pesan log supaya `/logs` bisa menyediakan tautan lompat.
  logMessageId String? @db.VarChar(20)
  /// Nomor kasus moderasi Harmony (tanpa `#`, mis. `142`) kalau aksi datang dari
  /// perintah bot; null = aksi moderator lain atau sistem Discord.
  caseId       String?      @db.VarChar(20)
  createdAt DateTime  @default(now())
  /// Retensi (Bab 12 privasi): dipakai job pembersihan berkala.
  expiresAt DateTime?

  @@index([guildId, category, createdAt(sort: Desc)])
  @@index([guildId, targetId, createdAt(sort: Desc)])
  @@index([guildId, executorId, createdAt(sort: Desc)])
  @@index([guildId, channelId, createdAt(sort: Desc)])
  @@index([guildId, caseId])
  @@map("log_entry")
}

/// Satu pesan panel self-assign role (Fase 2, PRD §7.4).
/// Maksimal 25 role per panel — batas opsi string select menu Discord.
model ReactionRolePanel {
  id      Int      @id @default(autoincrement())
  guildId String   @db.VarChar(20)
  channelId String @db.VarChar(20)
  /// ID pesan panel; null kalau pesan belum sempat terkirim.
  messageId String? @db.VarChar(20)
  /// Kapan select menu harus mati; null = panel permanen.
  expiresAt DateTime?
  /// Kapan panel benar-benar dinonaktifkan (oleh job atau perintah close).
  /// Panel yang punya nilai ini tidak akan disapu lagi.
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options ReactionRoleOption[]

  @@index([guildId, createdAt(sort: Desc)])
  /// Disapu job penyapuan: panel dengan masa hidup yang sudah lewat.
  @@index([expiresAt])
  @@map("reaction_role_panel")
}

/// Satu role yang bisa diambil member sendiri lewat select menu.
model ReactionRoleOption {
  id      Int @id @default(autoincrement())
  panelId Int
  roleId  String @db.VarChar(20)
  /// Nama yang tampil di select menu; null = pakai nama role aslinya.
  label      String? @db.VarChar(100)
  /// Emoji role Discord dipakai sebagai ikon opsi kalau ada.
  emoji      String? @db.VarChar(20)
  description String? @db.VarChar(100)
  position   Int      @default(0)

  panel ReactionRolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, roleId])
  @@index([panelId, position])
  @@map("reaction_role_option")
}

/// Tiket support: satu channel privat per tiket (Fase 2, PRD §5.2).
/// Ditutup berarti channel diarsipkan (dikunci & diganti namanya), bukan dihapus.
model Ticket {
  id          Int      @id @default(autoincrement())
  ticketNumber Int
  guildId     String   @db.VarChar(20)
  /// Channel tiket; null kalau channel dihapus manual di luar bot.
  channelId String? @db.VarChar(20)
  openerId  String   @db.VarChar(20)
  subject   String?  @db.VarChar(200)
  /// open | closed
  status    String   @db.VarChar(20)
  /// Staff yang mengambil alih tiket ini.
  claimedBy String?  @db.VarChar(20)
  createdAt DateTime @default(now())
  closedAt  DateTime?
  closedBy  String?  @db.VarChar(20)
  /// Retensi (Bab 12 privasi): tiket yang ditutup & lewat batas akan dihapus.
  expiresAt DateTime?
  /// Isi percakapan channel tiket, diambil saat ditutup (lihat §12 privasi).
  /// Disimpan sebagai JSON di baris yang sama supaya ikut hilang bersama tiket —
  /// tidak ada data percakapan yatim yang tertinggal setelah retensi berjalan.
  transcript Json?

  @@unique([guildId, ticketNumber])
  @@index([guildId, status, createdAt(sort: Desc)])
  @@index([guildId, openerId, status])
  @@index([guildId, status, closedAt])
  @@map("ticket")
}
