# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN pernah commit file .env — sudah ada di .gitignore.

# ── Discord ────────────────────────────────────────────────
# Bot token: Discord Developer Portal → Applications → Bot → Reset Token
DISCORD_TOKEN=
# Application ID: Developer Portal → Applications → General Information
DISCORD_CLIENT_ID=
# ID server testing (opsional). Kalau diisi, slash command didaftarkan instan
# ke server tersebut. Kalau kosong, didaftarkan global (butuh ±1 jam).
DEV_GUILD_ID=

# ────────────────────────── Database: Supabase ─────────────────────────
#
# Supabase adalah PostgreSQL, jadi bot TETAP memakai Prisma + driver adapter pg.
# Yang berubah hanya alamat koneksinya. Jangan pasang @supabase/supabase-js di sini:
# library itu untuk Data API (REST/Row Level Security) di sisi klien, sedangkan
# bot ini punya skema dan migrasinya sendiri.
#
# Ambil stringnya dari: Supabase Dashboard -> Project -> Connect.
# PENTING: pilih mode sesuai jaringanmu. Salah pilih = tidak bisa konek.
#
#   Session pooler (port 5432)  IPv4 maupun IPv6, mendukung prepared statement.
#                             Hampir selalu ini yang kamu punya.
#   Direct connection (5432)   Hanya IPv6, atau kalau proyek punya IPv4 add-on.
#   Transaction pooler (6543)  TANPA prepared statement. Perlu ?pgbouncer=true
#                             DAN tidak bisa dipakai Prisma CLI. Jangan untuk bot ini.
#
# Catatan username berbeda per mode: koneksi direct memakai `postgres`,
# sedangkan pooler memakai `postgres.PROJECT-REF`. Salin saja dari dialog Connect.
# Karakter khusus pada password (&, #, ?, spasi) harus di percent-encode.
#
# DATABASE_URL -> bot saat runtime. Boleh lewat pooler.
DATABASE_URL=postgresql://postgres.PROJECT-REF:PASSWORD@POOLER-HOST:5432/postgres?sslmode=require
#
# DIRECT_URL -> hanya Prisma CLI (migrate deploy, db:studio, db push).
# Wajib direct atau session mode (port 5432), bukan transaction pooler.
# Kosongkan kalau masih memakai Postgres lokal.
DIRECT_URL=postgresql://postgres.PROJECT-REF:PASSWORD@POOLER-HOST:5432/postgres?sslmode=require
#
# Alur migrasi terhadap Supabase: `prisma migrate dev` BUTUH shadow database,
# dan Supabase tidak mengizinkan membuatnya. Jadi pakai `npm run db:deploy` saja.
# Menulis file migrasi baru tetap dilakukan di Postgres lokal (compose profile
# `local`), lalu hasilnya di-deploy ke Supabase.

# ── Cache: Redis ──────────────────────────────────────────────────────────
# Dipakai untuk store kunci-nilai (rate limit lintas proses: slash command,
# tombol, dan perintah custom). Kalau Redis tidak terjangkau saat start, bot
# TETAP jalan dengan penyimpanan memori dan menulis peringatan di log —
# artinya rate limit berlaku per proses sampai Redis hidup lagi.
REDIS_URL=redis://localhost:6379

# ── Postgres lokal (opsional) ─────────────────────────────────────────────
# HANYA untuk menulis & menguji migrasi secara lokal. Isi database yang
# dipakai bot tetap Supabase, jadi tiga variabel ini tidak memengaruhi
# database bot sama sekali.
#   docker compose --profile local up -d postgres
POSTGRES_USER=harmony
POSTGRES_PASSWORD=harmony_dev_password
POSTGRES_DB=harmony

# ── Lavalink (mesin audio) ─────────────────────────────────
# Daftar node untuk multi-node (PRD 5.3). Kosong = pakai pasangan
# LAVALINK_HOST/LAVALINK_PORT di bawah, jadi konfigurasi lama tetap berlaku.
# Format: "host:port,host:port". Port boleh dikosongkan (pakai LAVALINK_PORT).
# Entri yang rusak dibuang dan dicatat di log, bukan menggagalkan startup.
# LAVALINK_NODES=
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=harmony_dev_password

# ── Perilaku bot ───────────────────────────────────────────
# Health check endpoint (PRD 5.1): GET /health (proses hidup) dan
# GET /ready (semua dependency siap). 0 = matikan endpoint.
HEALTH_PORT=8080

NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
DEFAULT_VOLUME=100
MAX_QUEUE_SIZE=500

# ── Retensi data ───────────────────────────────────────────
# Berapa jam sekali bot menghapus kasus moderasi & peringatan yang lebih tua
# dari 12 bulan (Bab 12 PRD). 0 = matikan penjadwalan, mis. kalau cleaners
# dijalankan dari cron luar lewat `npm run db:prune`.
RETENTION_SWEEP_HOURS=6

# ── Panel reaction role sementara ───────────────────────────
# Berapa menit sekali bot menonaktifkan panel reaction role yang sudah lewat
# masa hidup (`/reactionrole post … duration:7d`). Penonaktifannya melepas
# select menu dari pesan; pesan & datanya tidak dihapus.
# 0 = matikan penjadwalan. Penolakan select menu tetap berlaku walau dimatikan.
PANEL_EXPIRY_SWEEP_MINUTES=15

# ── Mode 24/7 (PRD 5.2) ──────────────────────────────────
# Berapa menit sekali bot mengecek tiap server dan menyambung kembali ke
# voice channel 24/7 (`/247 join`). Menutup kasus bot ter-kick, restart,
# atau shard reconnect. Bot juga tidak keluar otomatis selama mode ini aktif.
# 0 = matikan penjadwalan (bot hanya mengikuti /247 join & /247 leave).
STAY_SWEEP_MINUTES=5

# ── Lirik (PRD 5.2) ────────────────────────────────────────
# Sumber utama LRCLIB: gratis, tanpa API key, lirik ikut timing.
# Ganti hanya kalau kamu memakai mirror sendiri.
LYRCLIB_BASE_URL=https://lrclib.net/api
# Cadangan opsional kalau LRCLIB tidak punya lirik untuk sebuah lagu.
# Token dibuat gratis di https://genius.com/api-clients
# Kosongkan (= default) kalau tidak mau memakai Genius sama sekali.
GENIUS_ACCESS_TOKEN=

# Metadata Spotify: hanya judul/metadata (cover, album, durasi). Audio tetap
# dicari di Lavalink, jadi tidak butuh Spotify Premium.
# Kredensial dibuat di https://developer.spotify.com/dashboard (Client Credentials).
# Kosongkan kalau tidak mau memakai tautan Spotify sama sekali.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
